# Environment for running the native binary directly (Docker, tests, custom clients).
# The binary reads exported variables; it does not load this file.
# The installed service does not need this: it uses runtime.json and openrouter.env.

# Required
# local (offline, no model calls) or openrouter
LAMBDA_MEMORY_MODE=local
LAMBDA_MEMORY_DATA_DIR=/path/to/private/store
LAMBDA_MEMORY_OWNER=me
LAMBDA_MEMORY_ACTOR=me
LAMBDA_MEMORY_PROJECT=demo
LAMBDA_MEMORY_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# openrouter mode only
# OPEN_ROUTER_KEY=sk-or-REPLACE_LOCALLY_NEVER_COMMIT
# The models are pinned. These lines are optional, and any other value is rejected.
# LAMBDA_PLANNER_MODEL=anthropic/claude-haiku-5.5
# LAMBDA_EMBEDDING_MODEL=google/gemini-embedding-2
# LAMBDA_SELECTOR_MODEL=openai/gpt-6-luna-decisions

# Optional: extra projects that memory_recall may read (comma-separated)
# LAMBDA_MEMORY_ALLOWED_PROJECTS=another-project

# Optional limits (see docs/reference.md)
# LAMBDA_MEMORY_CONTEXT_TOKENS=1000
# LAMBDA_MEMORY_IDLE_MS=60000
# LAMBDA_MEMORY_DREAM_BATCH=8
# LAMBDA_MEMORY_TICK_MS=1000
# LAMBDA_MEMORY_MAX_PENDING=1024
# LAMBDA_MEMORY_MAX_CONTENT_BYTES=8192
# LAMBDA_MEMORY_MAX_CANDIDATES=8
# Unset keeps sources forever.
# LAMBDA_MEMORY_RETENTION_MS=
