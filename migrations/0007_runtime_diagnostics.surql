DEFINE TABLE memory_runtime_activity SCHEMAFULL;
DEFINE FIELD owner_id ON memory_runtime_activity TYPE string READONLY;
DEFINE FIELD project_id ON memory_runtime_activity TYPE string READONLY;
DEFINE FIELD entry_id ON memory_runtime_activity TYPE string READONLY;
DEFINE FIELD parent_id ON memory_runtime_activity TYPE option<string> READONLY;
DEFINE FIELD root_id ON memory_runtime_activity TYPE string READONLY;
DEFINE FIELD instance_id ON memory_runtime_activity TYPE string READONLY;
DEFINE FIELD entry_kind ON memory_runtime_activity TYPE string READONLY;
DEFINE FIELD operation ON memory_runtime_activity TYPE string READONLY;
DEFINE FIELD phase ON memory_runtime_activity TYPE string;
DEFINE FIELD started_at_ms ON memory_runtime_activity TYPE int READONLY;
DEFINE FIELD finished_at_ms ON memory_runtime_activity TYPE option<int>;
DEFINE FIELD classified_at_ms ON memory_runtime_activity TYPE option<int>;
DEFINE FIELD duration_ms ON memory_runtime_activity TYPE option<int>;
DEFINE FIELD outcome ON memory_runtime_activity TYPE string;
DEFINE FIELD reason ON memory_runtime_activity TYPE option<string>;
DEFINE FIELD counts ON memory_runtime_activity TYPE object FLEXIBLE;
DEFINE FIELD source_ids ON memory_runtime_activity TYPE array<string>;
DEFINE FIELD revision_ids ON memory_runtime_activity TYPE array<string>;
DEFINE FIELD paid_operation ON memory_runtime_activity TYPE option<string>;
DEFINE INDEX activity_identity ON memory_runtime_activity FIELDS owner_id, project_id, entry_id UNIQUE;
DEFINE INDEX activity_order ON memory_runtime_activity FIELDS owner_id, project_id, started_at_ms, entry_id;
DEFINE INDEX activity_root ON memory_runtime_activity FIELDS owner_id, project_id, root_id;
DEFINE INDEX activity_instance ON memory_runtime_activity FIELDS owner_id, project_id, instance_id, outcome;
DEFINE TABLE memory_runtime_activity_meta SCHEMAFULL;
DEFINE FIELD owner_id ON memory_runtime_activity_meta TYPE string READONLY;
DEFINE FIELD project_id ON memory_runtime_activity_meta TYPE string READONLY;
DEFINE FIELD started_at_ms ON memory_runtime_activity_meta TYPE int READONLY;
DEFINE INDEX activity_meta_identity ON memory_runtime_activity_meta FIELDS owner_id, project_id UNIQUE;
