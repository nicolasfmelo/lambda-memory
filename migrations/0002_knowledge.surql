DEFINE TABLE memory_job SCHEMAFULL;
DEFINE FIELD owner_id ON memory_job TYPE string READONLY;
DEFINE FIELD project_id ON memory_job TYPE string READONLY;
DEFINE FIELD job_id ON memory_job TYPE string READONLY;
DEFINE FIELD watermark_ms ON memory_job TYPE int READONLY;
DEFINE FIELD sources ON memory_job TYPE array<object> FLEXIBLE READONLY;
DEFINE FIELD status ON memory_job TYPE string;
DEFINE FIELD revisions ON memory_job TYPE array<object> FLEXIBLE;
DEFINE INDEX job_identity ON memory_job FIELDS owner_id, job_id UNIQUE;
DEFINE TABLE memory_revision SCHEMAFULL;
DEFINE FIELD owner_id ON memory_revision TYPE string READONLY;
DEFINE FIELD project_id ON memory_revision TYPE string READONLY;
DEFINE FIELD revision_id ON memory_revision TYPE string READONLY;
DEFINE FIELD memory_id ON memory_revision TYPE string READONLY;
DEFINE FIELD job_id ON memory_revision TYPE string READONLY;
DEFINE FIELD watermark_ms ON memory_revision TYPE int READONLY;
DEFINE FIELD kind ON memory_revision TYPE string READONLY;
DEFINE FIELD status ON memory_revision TYPE string READONLY;
DEFINE FIELD content ON memory_revision TYPE string READONLY;
DEFINE FIELD prerequisites ON memory_revision TYPE array<string> READONLY;
DEFINE FIELD sources ON memory_revision TYPE array<string> READONLY;
DEFINE FIELD predecessor ON memory_revision TYPE option<string> READONLY;
DEFINE FIELD model ON memory_revision TYPE string READONLY;
DEFINE FIELD prompt_version ON memory_revision TYPE string READONLY;
DEFINE INDEX revision_identity ON memory_revision FIELDS owner_id, revision_id UNIQUE;
DEFINE INDEX revision_scope ON memory_revision FIELDS owner_id, project_id, watermark_ms;
