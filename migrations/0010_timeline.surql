DEFINE TABLE memory_timeline_version SCHEMAFULL;
DEFINE FIELD owner_id ON memory_timeline_version TYPE string READONLY;
DEFINE FIELD project_id ON memory_timeline_version TYPE string READONLY;
DEFINE FIELD entry_id ON memory_timeline_version TYPE string READONLY;
DEFINE FIELD actor_id ON memory_timeline_version TYPE string READONLY;
DEFINE FIELD title ON memory_timeline_version TYPE string READONLY;
DEFINE FIELD summary ON memory_timeline_version TYPE string READONLY;
DEFINE FIELD status ON memory_timeline_version TYPE string READONLY;
DEFINE FIELD version ON memory_timeline_version TYPE int READONLY;
DEFINE FIELD occurred_at_ms ON memory_timeline_version TYPE int READONLY;
DEFINE FIELD recorded_at_ms ON memory_timeline_version TYPE int READONLY;
DEFINE FIELD sources ON memory_timeline_version TYPE array<string> READONLY;
DEFINE FIELD revisions ON memory_timeline_version TYPE array<string> READONLY;
DEFINE FIELD memories ON memory_timeline_version TYPE array<string> READONLY;
DEFINE FIELD tags ON memory_timeline_version TYPE array<string> READONLY;
DEFINE FIELD supersedes ON memory_timeline_version TYPE option<string> READONLY;
DEFINE INDEX timeline_version_identity ON memory_timeline_version FIELDS owner_id, project_id, entry_id, version UNIQUE;
DEFINE TABLE memory_timeline_head SCHEMAFULL;
DEFINE FIELD owner_id ON memory_timeline_head TYPE string READONLY;
DEFINE FIELD project_id ON memory_timeline_head TYPE string READONLY;
DEFINE FIELD entry_id ON memory_timeline_head TYPE string READONLY;
DEFINE FIELD version ON memory_timeline_head TYPE int;
DEFINE FIELD occurred_at_ms ON memory_timeline_head TYPE int;
DEFINE FIELD status ON memory_timeline_head TYPE string;
DEFINE FIELD sources ON memory_timeline_head TYPE array<string>;
DEFINE INDEX timeline_head_identity ON memory_timeline_head FIELDS owner_id, project_id, entry_id UNIQUE;
DEFINE INDEX timeline_head_order ON memory_timeline_head FIELDS owner_id, project_id, occurred_at_ms, entry_id;
DEFINE INDEX source_kind_scope ON memory_source FIELDS owner_id, project_id, kind;
