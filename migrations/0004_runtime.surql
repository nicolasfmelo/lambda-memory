DEFINE TABLE memory_source_consumption SCHEMAFULL;
DEFINE FIELD owner_id ON memory_source_consumption TYPE string READONLY;
DEFINE FIELD project_id ON memory_source_consumption TYPE string READONLY;
DEFINE FIELD source_id ON memory_source_consumption TYPE string READONLY;
DEFINE FIELD job_id ON memory_source_consumption TYPE string READONLY;
DEFINE INDEX consumption_identity ON memory_source_consumption FIELDS owner_id, source_id UNIQUE;
DEFINE TABLE memory_revision_state SCHEMAFULL;
DEFINE FIELD owner_id ON memory_revision_state TYPE string READONLY;
DEFINE FIELD project_id ON memory_revision_state TYPE string READONLY;
DEFINE FIELD revision_id ON memory_revision_state TYPE string READONLY;
DEFINE FIELD memory_id ON memory_revision_state TYPE string READONLY;
DEFINE FIELD state ON memory_revision_state TYPE string;
DEFINE FIELD reviewed_at_ms ON memory_revision_state TYPE option<int>;
DEFINE FIELD reviewed_by ON memory_revision_state TYPE option<string>;
DEFINE INDEX revision_state_identity ON memory_revision_state FIELDS owner_id, revision_id UNIQUE;
DEFINE INDEX revision_state_scope ON memory_revision_state FIELDS owner_id, project_id, state;
DEFINE TABLE memory_active_head SCHEMAFULL;
DEFINE FIELD owner_id ON memory_active_head TYPE string READONLY;
DEFINE FIELD project_id ON memory_active_head TYPE string READONLY;
DEFINE FIELD memory_id ON memory_active_head TYPE string READONLY;
DEFINE FIELD revision_id ON memory_active_head TYPE string;
DEFINE INDEX active_head_identity ON memory_active_head FIELDS owner_id, project_id, memory_id UNIQUE;
DEFINE TABLE memory_revision_conflict SCHEMAFULL;
DEFINE FIELD owner_id ON memory_revision_conflict TYPE string READONLY;
DEFINE FIELD project_id ON memory_revision_conflict TYPE string READONLY;
DEFINE FIELD memory_id ON memory_revision_conflict TYPE string READONLY;
DEFINE FIELD left_id ON memory_revision_conflict TYPE string READONLY;
DEFINE FIELD right_id ON memory_revision_conflict TYPE string READONLY;
DEFINE FIELD resolved ON memory_revision_conflict TYPE bool;
DEFINE FIELD selected_id ON memory_revision_conflict TYPE option<string>;
DEFINE INDEX conflict_pair ON memory_revision_conflict FIELDS owner_id, project_id, left_id, right_id UNIQUE;
DEFINE TABLE memory_lifecycle_audit SCHEMAFULL;
DEFINE FIELD owner_id ON memory_lifecycle_audit TYPE string READONLY;
DEFINE FIELD project_id ON memory_lifecycle_audit TYPE string READONLY;
DEFINE FIELD revision_id ON memory_lifecycle_audit TYPE string READONLY;
DEFINE FIELD actor_id ON memory_lifecycle_audit TYPE string READONLY;
DEFINE FIELD action ON memory_lifecycle_audit TYPE string READONLY;
DEFINE FIELD from_state ON memory_lifecycle_audit TYPE string READONLY;
DEFINE FIELD to_state ON memory_lifecycle_audit TYPE string READONLY;
DEFINE FIELD expected_active ON memory_lifecycle_audit TYPE option<string> READONLY;
DEFINE FIELD conflict_with ON memory_lifecycle_audit TYPE option<string> READONLY;
DEFINE FIELD at_ms ON memory_lifecycle_audit TYPE int READONLY;
