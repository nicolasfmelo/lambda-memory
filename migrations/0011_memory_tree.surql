DEFINE TABLE memory_tree_revision SCHEMAFULL;
DEFINE FIELD owner_id ON memory_tree_revision TYPE string READONLY;
DEFINE FIELD project_id ON memory_tree_revision TYPE string READONLY;
DEFINE FIELD revision_id ON memory_tree_revision TYPE string READONLY;
DEFINE FIELD memory_id ON memory_tree_revision TYPE string READONLY;
DEFINE FIELD tree_root ON memory_tree_revision TYPE string READONLY;
DEFINE FIELD parent_memory ON memory_tree_revision TYPE option<string>;
DEFINE FIELD depth ON memory_tree_revision TYPE int;
DEFINE FIELD title ON memory_tree_revision TYPE string READONLY;
DEFINE INDEX tree_revision_identity ON memory_tree_revision FIELDS owner_id, revision_id UNIQUE;
DEFINE TABLE memory_tree_edge SCHEMAFULL;
DEFINE FIELD owner_id ON memory_tree_edge TYPE string READONLY;
DEFINE FIELD project_id ON memory_tree_edge TYPE string READONLY;
DEFINE FIELD parent_memory ON memory_tree_edge TYPE string;
DEFINE FIELD child_memory ON memory_tree_edge TYPE string READONLY;
DEFINE FIELD created_at_ms ON memory_tree_edge TYPE int READONLY;
DEFINE INDEX tree_edge_child ON memory_tree_edge FIELDS owner_id, project_id, child_memory UNIQUE;
DEFINE INDEX tree_edge_parent ON memory_tree_edge FIELDS owner_id, project_id, parent_memory;
DEFINE TABLE memory_node_source SCHEMAFULL;
DEFINE FIELD owner_id ON memory_node_source TYPE string READONLY;
DEFINE FIELD project_id ON memory_node_source TYPE string READONLY;
DEFINE FIELD memory_id ON memory_node_source TYPE string READONLY;
DEFINE FIELD source_id ON memory_node_source TYPE string READONLY;
DEFINE FIELD revision_id ON memory_node_source TYPE string READONLY;
DEFINE FIELD operation ON memory_node_source TYPE string READONLY;
DEFINE FIELD linked_at_ms ON memory_node_source TYPE int READONLY;
DEFINE INDEX node_source_memory ON memory_node_source FIELDS owner_id, project_id, memory_id;
DEFINE INDEX node_source_source ON memory_node_source FIELDS owner_id, project_id, source_id;
DEFINE TABLE memory_tree_state SCHEMAFULL;
DEFINE FIELD owner_id ON memory_tree_state TYPE string READONLY;
DEFINE FIELD project_id ON memory_tree_state TYPE string READONLY;
DEFINE FIELD mode ON memory_tree_state TYPE string;
DEFINE FIELD migrated_at_ms ON memory_tree_state TYPE option<int>;
DEFINE FIELD stale ON memory_tree_state TYPE array<string>;
DEFINE FIELD split_queue ON memory_tree_state TYPE array<string>;
DEFINE FIELD rebuild_queue ON memory_tree_state TYPE array<string>;
DEFINE FIELD parked ON memory_tree_state TYPE array<object> FLEXIBLE;
DEFINE INDEX tree_state_scope ON memory_tree_state FIELDS owner_id, project_id UNIQUE;
